# デフォルトの挙動：すべてのテキストファイルをLFに強制変換してコミット
# チェックアウト時はOSの設定に従わずLFのままにする（クロスプラットフォームでの事故防止）
* text=auto eol=lf
# ---------------------------------------------------------
# Windows固有のファイル
# ---------------------------------------------------------
# バッチファイルはCRLFでないと動かない場合があるため例外設定
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# ---------------------------------------------------------
# Linux/Unix固有のファイル
# ---------------------------------------------------------
# シェルスクリプトは絶対にLFである必要がある
*.sh text eol=lf
# MakefileやリンカスクリプトもLF推奨
Makefile text eol=lf
*.mk     text eol=lf
*.ld     text eol=lf
# ---------------------------------------------------------
# 言語ごとの明示的な指定（念のため）
# ---------------------------------------------------------
*.rs text eol=lf
*.toml text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.asm text eol=lf
*.S text eol=lf
# ---------------------------------------------------------
# バイナリファイル（Gitに改行コードを変換させない設定）
# ---------------------------------------------------------
# 画像やフォント、コンパイル済みバイナリが壊れるのを防ぐ
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.doc filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
*.xls filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text
*.ppt filter=lfs diff=lfs merge=lfs -text
*.pptx filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
# OS自作で扱う可能性のあるバイナリ系
*.bin filter=lfs diff=lfs merge=lfs -text
*.img filter=lfs diff=lfs merge=lfs -text
*.iso filter=lfs diff=lfs merge=lfs -text
*.o filter=lfs diff=lfs merge=lfs -text
