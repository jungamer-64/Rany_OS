/*
 * NOTE: This file has been renamed to `linker.ld.sample` to avoid confusion
 * with the kernel-specific linker script at `kernel/linker.ld` which is the
 * one actually used for kernel builds (see `.cargo/config.toml`).
 *
 * This file is kept as an example/template only and is not used by the build.
 */
OUTPUT_FORMAT(elf64-x86-64)
ENTRY(kmain)

PHDRS
{
    text            PT_LOAD FLAGS(5);  /* rx */
    rodata          PT_LOAD FLAGS(4);  /* r  */
    data            PT_LOAD FLAGS(6);  /* rw */
}

SECTIONS
{
    /* Higher half kernel at -2GiB */
    . = 0xffffffff80000000;
    __kernel_start = .;

    /* Code section */
    .text : {
        *(.text .text.*)
    } :text

    /* Read-only data */
    . = ALIGN(CONSTANT(MAXPAGESIZE));
    .rodata : {
        *(.rodata .rodata.*)
    } :rodata

    /* Data section */
    . = ALIGN(CONSTANT(MAXPAGESIZE));
    .data : {
        *(.data .data.*)

        /* Place the sections that contain the Limine requests as part of the .data */
        /* output section. */
        KEEP(*(.requests_start_marker))
        KEEP(*(.requests))
        KEEP(*(.requests_end_marker))
    } :data

    /* BSS - uninitialized data */
    /* NOTE: .bss needs to be the last thing mapped to :data, otherwise lots of */
    /* unnecessary zeros will be written to the binary. */
    .bss : {
        __bss_start = .;
        *(.bss .bss.*)
        *(COMMON)
        __bss_end = .;
    } :data

    __kernel_end = .;

    /* Discard unnecessary sections */
    /DISCARD/ : {
        *(.eh_frame*)
        *(.note*)
        *(.comment*)
    }
}
